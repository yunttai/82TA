# Service API
SERVICE_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://service_app:password@service-db.example.internal:5432/service?sslmode=require
SERVICE_MIGRATION_DATABASE_URL=postgresql://service_migrator:password@service-db.example.internal:5432/service?sslmode=require
SERVICE_REDIS_URL=rediss://service-redis.example.internal:6379/0
SERVICE_REDIS_KEY_DERIVATION_SECRET=replace-with-at-least-32-random-characters
SERVICE_ROUTING_JWT_SECRET=replace-with-at-least-32-random-characters
SERVICE_DATA_RIGHTS_ARTIFACT_BACKEND=disabled
SERVICE_DATA_RIGHTS_ARTIFACT_DIRECTORY=
SERVICE_DATA_RIGHTS_ARTIFACT_ENCRYPTION_KEY=

# Routing API (separate Routing-owned PostGIS database and migration role)
ROUTING_DJANGO_SECRET_KEY=replace-with-at-least-50-strong-random-characters
ROUTING_DB_NAME=routing
ROUTING_DB_USER=routing_app
ROUTING_DB_PASSWORD=replace-me
ROUTING_DB_MIGRATION_USER=routing_migrator
ROUTING_DB_MIGRATION_PASSWORD=replace-me
ROUTING_DB_HOST=routing-db.example.internal
ROUTING_DB_PORT=5432
ROUTING_REDIS_URL=rediss://routing-redis.example.internal:6379/0
ROUTING_PRODUCTION_DEPENDENCIES_FACTORY=routing_deployment.baseline:build_dependencies
ROUTING_PROVIDER_CONFIG_FACTORY=provider_core.production:build_kakao_baseline_config
ROUTING_PROVIDER_EVIDENCE_JSON={}
ROUTING_PROVIDER_HTTPS_PROXY_URL=

# Canonical Provider names
KAKAO_REST_API_KEY=
GBIS_SERVICE_KEY=
GITS_API_KEY=
TMAP_APP_KEY=
ODSAY_API_KEY=
