# Harness workspace
_workspace/**
!_workspace/README.md
!_workspace/service-product/.gitkeep
!_workspace/routing-intelligence/.gitkeep
!_workspace/integration/.gitkeep

# Generated client source, generator configuration, and package lock files are
# committed. Disposable dependency, environment, cache, and build directories
# remain excluded by the rules below and package-local ignore files.

# Secrets and local runtime
**/.env
**/.env.*
!**/.env.example
**/.routing-live-approval.json
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/node_modules/
**/dist/
**/build/
**/*.egg-info/
**/.coverage
**/coverage/
**/*.sqlite3
**/*.db
**/*.pkl

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

