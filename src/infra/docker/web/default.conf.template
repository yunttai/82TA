server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;
  add_header Content-Security-Policy "${CONTENT_SECURITY_POLICY}" always;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location /api/ {
    # Reverse geocoding accepts exact coordinates in the query string. Django
    # emits safe path/status metrics, so this proxy never emits raw API URLs.
    access_log off;
    proxy_pass http://${SERVICE_UPSTREAM};
    proxy_http_version 1.1;
    # Preserve the browser-visible authority (including a non-default port),
    # otherwise Django's CSRF origin comparison rejects legitimate mutations.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;
  }

  location = /index.html {
    add_header Cache-Control "no-store";
    try_files $uri =404;
  }

  location = /manifest.webmanifest {
    add_header Cache-Control "public, max-age=300, must-revalidate";
    try_files $uri =404;
  }

  location = /sw.js {
    add_header Cache-Control "no-store";
    add_header Service-Worker-Allowed "/";
    try_files $uri =404;
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
